graph TD
    CP[CommitProxy]
    Seq[Seq]
    Resolver[Resolver]

    subgraph TxnLog [Txn Log]
        L1[(Log 1)]
        L2[(Log 2)]
        L3[(Log 3)]
        L4[(Log 4)]
    end

    subgraph CommitLogBox [Commit Log]
        CL[(Commit Logs)]
    end

    LP1[Log Proxy]
    LP2[Log Proxy]

    SS1[(SS 1)]
    SS2[(SS 2)]
    SS3[(SS 3)]
    SS4[(SS 4)]
    SS5[(SS 5)]
    SS6[(SS 6)]

    %% Control Plane Interactions
    CP <--> |"① CV"| Seq
    CP <--> |"② Resolution"| Resolver
    
    %% Push Operations
    CP --> |"① Log Push (batch-UID)"| L1
    CP --> |"① Log Push (batch-UID)"| L2
    CP --> |"① Log Push (batch-UID)"| L3
    CP --> |"① Log Push (batch-UID)"| L4

    CP --> |"③ Commit (CV, batch-UID)"| CommitLogBox
    CP --> |"④ Commit (CV)"| Seq

    %% Log to Proxy Flow
    L1 --> LP1
    L2 --> LP1
    L3 --> LP2
    L4 --> LP2

    %% Secondary Inputs
    CommitLogBox --> LP1
    CommitLogBox --> LP2
    LP1 --> SS1
    LP1 --> SS2
    LP1 --> SS3
    LP2 --> SS4
    LP2 --> SS5
    LP2 --> SS6

    %% LP1 ~~~ SS3
    %% LP2 ~~~ SS2

